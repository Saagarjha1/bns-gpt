{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/query/stream",
      "destination": "/api/index.py"
    },
    {
      "source": "/api/auth/token",
      "destination": "/api/index.py"
    },
    {
      "source": "/api/health",
      "destination": "/api/index.py"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    }
  ],
  "functions": {
    "api/index.py": {
      "maxDuration": 60
    }
  }
}
